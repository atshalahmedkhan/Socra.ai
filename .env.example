# Application
APP_ENV=development
APP_NAME=Socra
APP_VERSION=0.1.0
DEBUG=false
LOG_LEVEL=INFO
LOG_FORMAT=console
API_V1_PREFIX=/api/v1
REQUEST_ID_HEADER=X-Request-ID
INTERNAL_ROUTES_ENABLED=false
INTERNAL_SERVICE_TOKEN=
FRONTEND_URL=http://localhost:3000
CORS_ALLOWED_ORIGINS=http://localhost:3000
# Browser-safe; never use service-role credentials in NEXT_PUBLIC variables.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_placeholder
# Temporary legacy compatibility; if both are set they must match.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Backend only
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_placeholder
SUPABASE_SECRET_KEY=sb_secret_your_placeholder
SUPABASE_STORAGE_BUCKET=learning-materials
# Temporary legacy compatibility; if both are set they must match their modern equivalent.
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=postgresql://postgres:your_url_encoded_password@db.your-project-ref.supabase.co:5432/postgres
INTERNAL_SMOKE_TOKEN=
SUPABASE_JWT_ISSUER=https://your-project-ref.supabase.co/auth/v1
SUPABASE_JWT_AUDIENCE=authenticated
SUPABASE_JWKS_URL=https://your-project-ref.supabase.co/auth/v1/.well-known/jwks.json
SUPABASE_JWT_SECRET=
RESEARCH_DATA_COLLECTION_ENABLED=false
ANONYMIZED_EVENT_LOGGING_ENABLED=false
CONSENT_VERSION=
HF_TOKEN=
HF_HOME=./.cache/huggingface
BASE_MODEL_NAME=google/gemma-3-4b-it
FALLBACK_BASE_MODEL_NAME=google/gemma-3-1b-it
MODEL_PRIMARY_NAME=gemma-3-4b-base
MODEL_STABLE_NAME=socra-gemma-v0
MODEL_VERSION=socra-gemma-v1
PROMPT_VERSION=socra-v1
MODEL_PRIMARY_URL=http://model-primary:8001
MODEL_PRIMARY_API_KEY=
MODEL_FALLBACK_ENABLED=false
MODEL_FALLBACK_URL=http://model-fallback:8002
MODEL_FALLBACK_API_KEY=
MODEL_FALLBACK_NAME=socra-gemma-v0
FALLBACK_MODEL_VERSION=gemma-3-1b-it
MODEL_PRIMARY_ADAPTER_PATH=/models/adapters/socra-gemma-v1
MODEL_STABLE_ADAPTER_PATH=/models/adapters/socra-gemma-v0
MODEL_PRIMARY_ADAPTER_ENABLED=false
MODEL_STABLE_ADAPTER_ENABLED=false
MODEL_CONNECT_TIMEOUT_SECONDS=5
MODEL_READ_TIMEOUT_SECONDS=30
MODEL_WRITE_TIMEOUT_SECONDS=5
MODEL_POOL_TIMEOUT_SECONDS=5
MODEL_TOTAL_DEADLINE_SECONDS=35
MODEL_MAX_RETRIES=1
MODEL_RETRY_BASE_DELAY_MS=250
MODEL_CIRCUIT_BREAKER_FAILURE_THRESHOLD=3
MODEL_CIRCUIT_BREAKER_RESET_SECONDS=30
MODEL_MAX_OUTPUT_TOKENS=128
MODEL_TEMPERATURE=0.4
MODEL_TOP_P=0.9
MODEL_MAX_CONCURRENCY=1
MODEL_HEALTH_TIMEOUT_SECONDS=3
MODEL_DEEP_HEALTH_ENABLED=false
BENCHMARK_RESULTS_DIR=./benchmark-results
VLLM_GPU_MEMORY_UTILIZATION=0.80
VLLM_MAX_MODEL_LEN=4096
VLLM_MAX_NUM_SEQS=1
VLLM_QUANTIZATION=
VLLM_LOAD_FORMAT=
FALLBACK_VLLM_GPU_MEMORY_UTILIZATION=0.30
FALLBACK_VLLM_MAX_MODEL_LEN=2048
FALLBACK_VLLM_MAX_NUM_SEQS=1
FALLBACK_VLLM_QUANTIZATION=
FALLBACK_VLLM_LOAD_FORMAT=
