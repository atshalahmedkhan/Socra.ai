# Copy required values from the same Supabase development project.
APP_ENV=development
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_placeholder
SUPABASE_SECRET_KEY=sb_secret_your_placeholder
DATABASE_URL=postgresql://postgres:your_url_encoded_password@db.your-project-ref.supabase.co:5432/postgres
SUPABASE_STORAGE_BUCKET=learning-materials

# Optional explicit JWT settings. The backend derives these from SUPABASE_URL when omitted.
SUPABASE_JWT_ISSUER=
SUPABASE_JWT_AUDIENCE=authenticated
SUPABASE_JWKS_URL=

# Temporary legacy aliases. Leave blank unless an existing environment depends on them.
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Deterministic adapter is test/development only and is not a real model.
MODEL_PROVIDER=vllm
MODEL_MOCK_SCENARIO=success
